<svg width="600" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="portfolio2Grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e74c3c;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#f39c12;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#d35400;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#portfolio2Grad)"/>
  <rect x="50" y="50" width="100" height="80" fill="rgba(255,255,255,0.2)" transform="rotate(15 100 90)"/>
  <rect x="350" y="200" width="120" height="90" fill="rgba(255,255,255,0.15)" transform="rotate(-10 410 245)"/>
  <text x="300" y="180" font-family="Arial, sans-serif" font-size="32" fill="white" text-anchor="middle" font-weight="bold">Urban Symphony</text>
  <text x="300" y="220" font-family="Arial, sans-serif" font-size="16" fill="white" text-anchor="middle">Mixed Media</text>
