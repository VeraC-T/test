  </defs>
  <rect width="100%" height="100%" fill="url(#portfolio3Grad)"/>
  <polygon points="100,100 200,80 180,180" fill="rgba(255,255,255,0.2)"/>
  <polygon points="400,150 500,130 480,230 380,210" fill="rgba(255,255,255,0.15)"/>
  <text x="300" y="200" font-family="Arial, sans-serif" font-size="32" fill="white" text-anchor="middle" font-weight="bold">Color Harmony</text>
  <text x="300" y="240" font-family="Arial, sans-serif" font-size="16" fill="white" text-anchor="middle">Abstract</text>
