<svg width="400" height="500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="portraitGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#9b59b6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8e44ad;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#portraitGrad)"/>
  <text x="200" y="220" font-family="Arial, sans-serif" font-size="28" fill="white" text-anchor="middle" font-weight="bold">Alexandra Chen</text>
  <text x="200" y="260" font-family="Arial, sans-serif" font-size="20" fill="white" text-anchor="middle">Digital Artist</text>
  <text x="200" y="300" font-family="Arial, sans-serif" font-size="16" fill="white" text-anchor="middle">Portrait</text>
</svg>